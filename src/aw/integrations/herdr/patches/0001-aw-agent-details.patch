@@ -0,0 +1,174 @@
+use super::*;
+
+fn state_with_aw_agents() -> ClientShellState {
+    let mut projected = snapshot();
+    let mut second = projected.panes[0].clone();
+    second.pane_id = "pane_2".into();
+    second.focused = false;
+    projected.panes.push(second);
+    projected.agents = (1..=2)
+        .map(|index| ClientShellAgent {
+            pane_id: format!("pane_{index}"),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: Some("qodercli".into()),
+            display_agent: None,
+            agent: Some("qodercli".into()),
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Working,
+            state_change_seq: index,
+            state_labels: Vec::new(),
+            tokens: vec![(
+                "aw_event_03".into(),
+                format!("tool.before: pane-{index} / pass 0 deny {index}"),
+            )],
+            focused: index == 1,
+        })
+        .collect();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("agent sidebar");
+    state
+}
+
+fn mouse(state: &mut ClientShellState, kind: MouseEventKind, rect: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: rect.x,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+fn text(frame: &FrameData) -> String {
+    frame
+        .cells
+        .chunks(usize::from(frame.width))
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn open_details(state: &mut ClientShellState, pane_id: &str) {
+    let rect = state
+        .hits
+        .agents
+        .iter()
+        .find(|(_, id)| id == pane_id)
+        .map(|(rect, _)| *rect)
+        .expect("agent row");
+    let outcome = mouse(state, MouseEventKind::Down(MouseButton::Right), rect);
+    assert!(outcome.requests.is_empty() && outcome.actions.is_empty());
+    let index = match &state.overlay {
+        Some(ClientShellOverlay::ContextMenu(menu)) => {
+            assert!(
+                matches!(&menu.target, ClientContextMenuTarget::Pane { pane_id: target, .. } if target == pane_id)
+            );
+            menu.items()
+                .iter()
+                .position(|item| item.action == ClientContextMenuAction::AwDetails)
+                .expect("AW details action")
+        }
+        _ => panic!("pane menu from agent row"),
+    };
+    state.compose(106, 30).expect("agent context menu");
+    let row = state.hits.context_menu_rows[index].0;
+    let outcome = mouse(state, MouseEventKind::Down(MouseButton::Left), row);
+    assert!(outcome.requests.is_empty() && outcome.actions.is_empty());
+}
+
+#[test]
+fn aw_details_right_click_uses_nonfocused_agent_pane() {
+    let mut state = state_with_aw_agents();
+    open_details(&mut state, "pane_2");
+    let frame = state.compose(106, 30).expect("AW details");
+    let rendered = text(&frame);
+    assert!(rendered.contains("Pane: pane_2"));
+    assert!(rendered.contains("Agent: qodercli / working"));
+    assert!(rendered.contains("tool.before: pane-2 / pass 0 deny 2"));
+    assert!(!rendered.contains("tool.before: pane-1"));
+    assert!(rendered.contains("security.violation: unavailable"));
+    assert!(rendered.contains("coverage.changed: unavailable"));
+    assert_eq!(
+        state.snapshot.as_ref().unwrap().focused_pane_id.as_deref(),
+        Some("pane_1")
+    );
+    let outcome = state.handle_input_bytes(b"\x1b");
+    assert!(state.overlay.is_none());
+    assert!(outcome.requests.is_empty() && outcome.actions.is_empty());
+}
+
+#[test]
+fn aw_details_live_expiry_does_not_retain_success() {
+    let mut state = state_with_aw_agents();
+    open_details(&mut state, "pane_2");
+    let mut update = state.snapshot.as_deref().unwrap().clone();
+    update.revision += 1;
+    update.agents[1].tokens.clear();
+    let mut updated_surface = surface();
+    updated_surface.projection_revision = update.revision;
+    state.set_snapshot(Box::new(update));
+    state.set_pane_surface(updated_surface);
+    let frame = state.compose(106, 30).expect("expired AW details");
+    let rendered = text(&frame);
+    assert!(rendered.contains("tool.before: unavailable"));
+    assert!(!rendered.contains("deny 2"));
+    let mut update = state.snapshot.as_deref().unwrap().clone();
+    update.revision += 1;
+    update.agents.retain(|agent| agent.pane_id != "pane_2");
+    let mut updated_surface = surface();
+    updated_surface.projection_revision = update.revision;
+    state.set_snapshot(Box::new(update));
+    state.set_pane_surface(updated_surface);
+    let rendered = text(&state.compose(106, 30).expect("removed agent"));
+    assert!(rendered.contains("Agent: unavailable"));
+    assert!(rendered.contains("Pane: pane_2"));
+}
+
+#[test]
+fn aw_details_scrolls_and_closes_with_mouse() {
+    let mut state = state_with_aw_agents();
+    open_details(&mut state, "pane_2");
+    state.compose(62, 15).expect("narrow details");
+    assert!(state.hits.aw_details_max_scroll > 0);
+    let popup = state.hits.aw_details_popup;
+    mouse(&mut state, MouseEventKind::ScrollDown, popup);
+    assert!(
+        matches!(&state.overlay, Some(ClientShellOverlay::AwDetails(details)) if details.scroll == 3)
+    );
+    let mut outcome = ClientShellInput::default();
+    state.route_overlay_key(
+        &crate::input::TerminalKey::new(KeyCode::End, KeyModifiers::empty()),
+        &mut outcome,
+    );
+    let rendered = text(&state.compose(62, 15).expect("last detail row"));
+    assert!(rendered.contains("coverage.changed: unavailable"));
+    state.compose(106, 30).expect("resized details");
+    let close = state.hits.overlay_cancel;
+    let outcome = mouse(&mut state, MouseEventKind::Down(MouseButton::Left), close);
+    assert!(state.overlay.is_none());
+    assert!(outcome.requests.is_empty() && outcome.actions.is_empty());
+}
+
+#[test]
+fn aw_details_remote_row_does_not_bind_local_same_id() {
+    let mut state = state_with_aw_agents();
+    let row = state.hits.agents[0].0;
+    state.hits.endpoint_agents.push((
+        row,
+        ClientEndpointId::Ssh(
+            crate::client::endpoint::ProfileId::parse("0123456789abcdef0123456789abcdef").unwrap(),
+        ),
+        "pane_1".into(),
+    ));
+    let outcome = mouse(&mut state, MouseEventKind::Down(MouseButton::Right), row);
+    assert!(state.overlay.is_none());
+    assert!(outcome.requests.is_empty() && outcome.actions.is_empty());
+}
