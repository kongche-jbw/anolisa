diff --git a/src/client/shell/aw_details.rs b/src/client/shell/aw_details.rs
new file mode 100644
index 0000000..ca0752b
--- /dev/null
+++ b/src/client/shell/aw_details.rs
@@ -0,0 +1,181 @@
+//! Render live AW metadata for one explicitly selected agent pane.
+
+use super::*;
+
+const EVENTS: [&str; 16] = [
+    "session.start",
+    "input.submit",
+    "tool.before",
+    "tool.after",
+    "permission.request",
+    "compact.before",
+    "compact.after",
+    "subagent.start",
+    "subagent.stop",
+    "turn.stop",
+    "session.end",
+    "model.before_request",
+    "runtime.observed",
+    "runtime.exited",
+    "security.violation",
+    "coverage.changed",
+];
+
+pub(super) fn render(
+    buffer: &mut Buffer,
+    details: &ClientAwDetailsOverlay,
+    snapshot: &ClientShellSnapshot,
+    palette: &Palette,
+) -> Option<OverlayRender> {
+    use ratatui::text::Line;
+    use ratatui::widgets::{Paragraph, Widget, Wrap};
+
+    let popup = popup(buffer.area, 100, 27)?;
+    let inner = panel(buffer, popup, palette.accent, palette.panel_bg)?;
+    let normal = Style::default().fg(palette.text).bg(palette.panel_bg);
+    put_text(
+        buffer,
+        inner.x,
+        inner.y,
+        inner.width.saturating_sub(13),
+        "AW details",
+        normal.add_modifier(Modifier::BOLD),
+    );
+    let close = Rect::new(
+        inner.right().saturating_sub(11).max(inner.x),
+        inner.y,
+        inner.width.min(11),
+        1,
+    );
+    button(
+        buffer,
+        close,
+        " esc close ",
+        Style::default().fg(contrast(palette)).bg(palette.accent),
+    );
+    let body = Rect::new(
+        inner.x,
+        inner.y.saturating_add(2),
+        inner.width,
+        inner.height.saturating_sub(3),
+    );
+    let agent = snapshot
+        .agents
+        .iter()
+        .find(|agent| agent.pane_id == details.pane_id);
+    let mut lines = vec![Line::raw(format!("Pane: {}", details.pane_id))];
+    if let Some(agent) = agent {
+        let name = agent
+            .display_agent
+            .as_deref()
+            .or(agent.agent.as_deref())
+            .unwrap_or("unknown");
+        lines.push(Line::raw(format!(
+            "Agent: {name} / {}",
+            status_text(agent.agent_status)
+        )));
+    } else {
+        lines.push(Line::raw(
+            "Agent: unavailable (pane exited or no current report)",
+        ));
+    }
+    lines.push(Line::raw(
+        "Live AW report; receipts do not prove final enforcement or adoption.",
+    ));
+    lines.push(Line::raw(""));
+    for (index, event) in EVENTS.iter().enumerate() {
+        let key = format!("aw_event_{:02}", index + 1);
+        let value = agent
+            .and_then(|agent| agent.tokens.iter().find(|(name, _)| name == &key))
+            .map(|(_, value)| value.clone())
+            .unwrap_or_else(|| format!("{event}: unavailable"));
+        let color = event_color(&value, palette);
+        lines.push(Line::styled(value, normal.fg(color)));
+    }
+    let paragraph = Paragraph::new(lines)
+        .style(normal)
+        .wrap(Wrap { trim: false });
+    let total_rows = paragraph.line_count(body.width.max(1));
+    let max_scroll = total_rows.saturating_sub(usize::from(body.height));
+    let scroll = details.scroll.min(max_scroll).min(usize::from(u16::MAX));
+    paragraph.scroll((scroll as u16, 0)).render(body, buffer);
+    if inner.height > 2 {
+        put_text(
+            buffer,
+            inner.x,
+            inner.bottom() - 1,
+            inner.width,
+            &format!(
+                "scroll: arrows / PgUp PgDn / wheel  |  {}-{} of {total_rows}",
+                scroll + 1,
+                (scroll + usize::from(body.height)).min(total_rows)
+            ),
+            Style::default().fg(palette.overlay0).bg(palette.panel_bg),
+        );
+    }
+    Some(OverlayRender {
+        cancel: close,
+        aw_details_popup: popup,
+        aw_details_max_scroll: max_scroll,
+        ..Default::default()
+    })
+}
+
+fn event_color(value: &str, palette: &Palette) -> ratatui::style::Color {
+    let count = |label: &str| {
+        value
+            .split_once(label)
+            .and_then(|(_, tail)| tail.split_whitespace().next())
+            .and_then(|count| count.parse::<u64>().ok())
+    };
+    if value.contains("failed")
+        || value.contains("unavailable")
+        || value.contains("GAP!")
+        || count("deny ").is_some_and(|count| count > 0)
+    {
+        palette.red
+    } else if value.contains("pending")
+        || value.contains("waiting")
+        || value.contains("not wired")
+        || value.contains("not attached")
+    {
+        palette.yellow
+    } else if count("pass ").is_some_and(|count| count > 0) && count("deny ") == Some(0) {
+        palette.green
+    } else if value.contains("seen ") {
+        palette.blue
+    } else {
+        palette.overlay0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn aw_details_colors_distinguish_denial_from_zero_and_missing_evidence() {
+        let palette = ClientShellConfig::from_config(&Config::default()).palette;
+        assert_eq!(
+            event_color("tool.before: seen 1 / pass 1 deny 0", &palette),
+            palette.green
+        );
+        assert_eq!(
+            event_color("tool.before: seen 1 / pass 0 deny 1", &palette),
+            palette.red
+        );
+        assert_eq!(
+            event_color("tool.before: seen 1 / pending 1", &palette),
+            palette.yellow
+        );
+        assert_eq!(event_color("tool.after: seen 1", &palette), palette.blue);
+        assert_eq!(
+            event_color("tool.after: evidence unavailable", &palette),
+            palette.red
+        );
+        assert_eq!(
+            event_color("security.violation: final not wired", &palette),
+            palette.yellow
+        );
+    }
+}
