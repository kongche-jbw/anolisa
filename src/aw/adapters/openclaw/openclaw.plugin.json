{
  "id": "aw-native-hooks",
  "name": "AW native tool hooks",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socket": {
        "type": "string"
      },
      "agent": {
        "type": "string"
      },
      "binary": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 14000
      },
      "hooks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer"
                },
                "matcher": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "onError": {
                  "type": "string",
                  "enum": [
                    "block",
                    "report"
                  ]
                }
              }
            }
          },
          "after": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer"
                },
                "matcher": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "onError": {
                  "type": "string",
                  "enum": [
                    "report"
                  ]
                }
              }
            }
          },
          "persist": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer"
                }
              }
            }
          },
          "result": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "matcher": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "contracts": {
    "agentToolResultMiddleware": [
      "openclaw"
    ]
  }
}
