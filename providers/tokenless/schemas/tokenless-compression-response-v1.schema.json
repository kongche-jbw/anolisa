{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/providers/tokenless/compression-response/v1",
  "title": "Tokenless CompressionResponse protocol v1",
  "type": "object",
  "required": [
    "protocol_version",
    "output",
    "disposition",
    "compressor_chain",
    "reversibility",
    "before_tokens",
    "after_tokens",
    "stash_keys",
    "tokenizer_id"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "output": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "applied",
        "dry_run",
        "passthrough",
        "no_savings",
        "reversibility_unavailable",
        "timeout",
        "error"
      ]
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "compressor_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reversibility": {
      "enum": ["lossless", "retrievable", "unrecoverable"]
    },
    "before_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "after_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "stash_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tokenizer_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": ["applied", "dry_run"]
          }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "compressor_chain": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "passthrough",
              "no_savings",
              "reversibility_unavailable",
              "timeout",
              "error"
            ]
          }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "compressor_chain": {
            "maxItems": 0
          },
          "reversibility": {
            "const": "lossless"
          },
          "stash_keys": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "dry_run"
          }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "reversibility": {
            "enum": ["lossless", "unrecoverable"]
          },
          "stash_keys": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "retrievable"
          }
        },
        "required": ["reversibility"]
      },
      "then": {
        "properties": {
          "stash_keys": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "lossless"
          }
        },
        "required": ["reversibility"]
      },
      "then": {
        "properties": {
          "stash_keys": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "not": {
              "const": "error"
            }
          }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "diagnostic": false
        }
      }
    }
  ],
  "additionalProperties": false
}
